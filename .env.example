# =============================================================================
# ملف مرجعي لأعدادات النسخة — للقراءة فقط
# =============================================================================
# هذا القالب لا يقرأ ملف .env ولا يحتوي على مكتبة dotenv.
# سبب اختيار ملفات PHP: كلمة مرور المدير تُخزَّن داخل PHP لا يمكن للمتصفح
# تنفيذه، ولا يُنشر بالخطأ مع الكود، وملف .env قد يُكشف في استضافة لا تدعم
# قواعد منع الوصول بشكل صحيح.
#
# مكان الإعدادات الحقيقي:  storage/config/local.php
# يُنشأ تلقائيًا عبر:
#   php bin/console install --url=... --user=... --pass=...
# أو عبر صفحة:  setup/index.php
#
# ما يلي هو مرجع لكل مفتاح ممكن — انسخه إلى storage/config/local.php
# وعدّله يدويًا إن احتجت تخصيصًا خارج لوحة الإدارة.
# ---------------------------------------------------------------------------

# المنطقة الزمنية للواجهة وقاعدة البيانات
# date_default_timezone_set = "Asia/Beirut"

# رابط الموقع العلني الكامل بدون شرطة مائلة في النهاية — يُستخدم في رموز QR
# 'app' => ['base_url' => 'https://example.com'],

# تفعيل عرض الأخطاء (ممنوع في الإنتاج)
# 'debug' => false,

# مفتاح عشوائي للنسخة: php -r "echo bin2hex(random_bytes(16));"
# 'app_key' => '...',

# مسار قاعدة البيانات
# 'db' => ['path' => '/var/www/project/storage/database/app.sqlite'],

# حساب المدير الوحيد.
# password_hash ناتج password_hash() — لا تضع كلمة المرور نصًا صريحًا هنا إطلاقًا.
# 'admin' => [
#     'username'      => 'admin',
#     'password_hash' => '$2y$10$....',
#     'updated_at'    => '2026-01-01 00:00:00',
# ],

# وقت إنشاء النسخة
# 'installed_at' => '2026-01-01 00:00:00',