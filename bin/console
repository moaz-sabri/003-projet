<?php

declare(strict_types=1);

/**
 * أداة سطر الأوامر للتهيئة والصيانة.
 *
 *   php bin/console install --url=https://site.com --user=admin --pass=secret \
 *        --preset=restaurant --name="مطعم النور"
 *   php bin/console migrate
 *   php bin/console migrate:fresh
 *   php bin/console instance state
 *   php bin/console instance destroy --force
 *   php bin/console admin:reset --force
 *   php bin/console preset [list|show|apply <المعرّف>]
 *   php bin/console backup
 *   php bin/console icons
 *   php bin/console qr "نص" --out=file.svg
 *   php bin/console status
 */

if (PHP_SAPI !== 'cli') {
    http_response_code(403);
    exit("أداة سطر الأوامر تعمل من الطرفية فقط.\n");
}

$autoloadOnly = true;
require __DIR__ . '/../src/Core/Autoloader.php';

$args = array_slice($argv, 1);
$command = $args[0] ?? 'help';

$options = [];
foreach (array_slice($args, 1) as $arg) {
    if (str_starts_with($arg, '--')) {
        $pair = explode('=', substr($arg, 2), 2);
        $options[$pair[0]] = $pair[1] ?? true;
    }
}

$say = static function (string $message, string $type = 'info'): void {
    $color = ['info' => "\033[36m", 'ok' => "\033[32m", 'warn' => "\033[33m", 'err' => "\033[31m"][$type] ?? '';
    fwrite(STDOUT, $color . $message . "\033[0m\n");
};

/* ------------------------------------------------------------------
 * تهيئة أولية (لا تحتاج bootstrap لأنها تُنشئ ملف الإعدادات)
 * ------------------------------------------------------------------ */

$writeLocalConfig = static function (array $config) use ($say): void {
    /*
     * كاتب واحد يُستخدم هنا وفي لوحة الإدارة وصفحة التهيئة:
     * يكتب في الملف نفسه الذي يقرأه التطبيق (app_config_file)، ويتحقّق من
     * نجاح الكتابة فعلًا، ويُبطل opcache حتى يسري التغيير فورًا.
     */
    \App\Core\LocalConfig::write($config);
};

$ensureInstalled = static function () use ($say): void {
    if (!is_file(app_config_file())) {
        $say('النسخة غير مهيأة بعد. شغّل: php bin/console install', 'err');
        exit(1);
    }
};

switch ($command) {
    /* ------------------------- تهيئة النسخة ------------------------- */
    case 'install': {
        if (is_file(app_config_file()) && empty($options['force'])) {
            $say('النسخة مهيأة مسبقًا. استخدم --force لإعادة التهيئة (سيُحذف ملف الإعدادات).', 'warn');
            exit(1);
        }

        $url  = rtrim((string) ($options['url'] ?? ''), '/');
        $user = (string) ($options['user'] ?? 'admin');
        $pass = (string) ($options['pass'] ?? '');

        if ($url === '') {
            $url = rtrim((string) (getcwd() ?: ''), '/');
        }
        if ($pass === '') {
            $pass = bin2hex(random_bytes(4));
            $say('لم تُحدَّد كلمة مرور — تم توليد واحدة: ' . $pass, 'warn');
        }
        if (mb_strlen($pass) < 8) {
            $say('كلمة المرور يجب ألا تقل عن 8 محارف.', 'err');
            exit(1);
        }

        $writeLocalConfig([
            'installed_at' => date('c'),
            'debug'        => false,
            'app_key'      => bin2hex(random_bytes(16)),
            'app'          => ['base_url' => $url],
            'db'           => ['path' => BASE_PATH . '/storage/database/app.sqlite'],
            'admin'        => [
                'username'      => $user,
                'password_hash' => password_hash($pass, PASSWORD_DEFAULT),
                'updated_at'    => date('c'),
            ],
        ]);

        require_once BASE_PATH . '/src/bootstrap.php';
        \App\Core\Migrations::migrate();

        /*
         * النمط (اختياري): --preset=orders_tables يحدد القدرات والتسميات
         * كما تفعل صفحة التهيئة، فيبقى التثبيت من الطرفية مطابقًا للتثبيت من الويب.
         * تُقبل معرّفات الأنشطة القديمة (restaurant/store…) للتوافق.
         */
        $presetId = (string) ($options['preset'] ?? \App\Config\TemplatePatterns::defaultId());
        if (!\App\Config\TemplatePatterns::exists($presetId)
            && !\App\Config\BusinessPresets::exists($presetId)) {
            $say('نمط غير معروف: ' . $presetId, 'err');
            $say('المتاح: ' . implode(', ', array_keys(\App\Config\TemplatePatterns::all())), 'err');
            exit(1);
        }
        $overrides = \App\Config\TemplatePatterns::toOverrides($presetId);
        \App\Config\ProjectConfig::setOverrides($overrides);

        $runtime = \App\Config\ProjectConfig::defaultRuntimeSettings();
        $runtime['business_preset'] = $presetId;
        $runtime['template_blueprint'] = json_encode(
            (array) ($overrides['template_blueprint'] ?? []),
            JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES
        ) ?: '';
        $runtime['welcome_message'] = '';
        $runtime['show_welcome'] = '0';
        if (!empty($options['name'])) {
            $runtime['app_name'] = mb_substr(trim((string) $options['name']), 0, 80);
        }
        if (!empty($options['tagline'])) {
            $runtime['app_tagline'] = mb_substr(trim((string) $options['tagline']), 0, 160);
        }
        \App\Core\RuntimeSettings::setMany($runtime);
        \App\Core\RuntimeSettings::flush();

        foreach (['uploads', 'backups', 'logs', 'tmp'] as $folder) {
            $path = BASE_PATH . '/storage/' . $folder;
            if (!is_dir($path)) {
                mkdir($path, 0775, true);
            }
        }

        // في الحاويات قد يكون التنفيذ بحساب root — نضبط الملكية ليستخدمها خادم الويب
        \App\Core\StorageWriter::fixTree(BASE_PATH . '/storage');
        \App\Core\StorageWriter::fixOwnership(app_config_file(), 0640);

        $say('تمت تهيئة النسخة بنجاح.', 'ok');
        $say('رابط الموقع : ' . $url);
        $say('لوحة الإدارة : ' . $url . '/admin/');
        $say('اسم المستخدم: ' . $user);
        $say('النمط       : ' . ($overrides['preset_label'] ?? $presetId) . ' — ' .
            (($overrides['mode'] ?? '') === \App\Config\TemplatePatterns::MODE_ORDERS
                ? 'مع نظام الطلبات' : 'عرض فقط'));

        /*
         * مفتاح الطوارئ: يولّد مرة واحدة ويُحفظ خارج جذر الويب. بدونه
         * صفحة emergency.php تردّ 404، فلا يوجد باب مفتوح افتراضيًا.
         */
        $emergencyService = new \App\Services\EmergencyService();
        $emergencyKey = $emergencyService->ensureKey();
        $emergencyUrl = $emergencyService->url();
        $emergencyDefaults = \App\Services\EmergencyService::defaults();
        $say('');
        $say('رابط التدمير الطارئ (سرّي — احفظه في مكان آمن):', 'head');
        $say('  ' . ($emergencyUrl !== '' ? $emergencyUrl : $url . '/emergency.php?key=' . $emergencyKey), 'ok');
        $say('  بيانات الطوارئ الافتراضية: ' . $emergencyDefaults['username']
            . ' / ' . $emergencyDefaults['password'], 'warn');

        // فحص أمان إلزامي: بعض الاستضافات لا تحجب الوصول للبيانات
        // داخل الحاوية لا يصل الخادم إلى رابطه العلني، لذا نجرّب عناوين داخلية.
        $exposure = ['state' => 'unknown', 'checked' => 0, 'exposed' => [], 'hint' => ''];
        $candidates = array_unique(array_filter([$url, 'http://127.0.0.1', 'http://localhost']));
        foreach ($candidates as $candidate) {
            $attempt = \App\Core\Security\ExposureCheck::run($candidate, 6, $url);
            if ($attempt['state'] === 'unknown') {
                $exposure['hint'] = $attempt['hint'];
                continue;
            }
            $exposure = $attempt;
            break;
        }

        $say('');
        if ($exposure['state'] === 'critical') {
            $say('⛔ تحذير أمني: بيانات حسّاسة مكشوفة على الإنترنت', 'err');
            foreach ($exposure['exposed'] as $item) {
                if ($item['severity'] === 'critical') {
                    $say('   - ' . $item['path'] . '  (HTTP ' . $item['status'] . ')', 'err');
                }
            }
            $say('');
            $say($exposure['hint'], 'warn');
            exit(1);
        }
        if ($exposure['state'] === 'secure') {
            $say('فحص الأمان: المسارات الحسّاسة محميّة ✔', 'ok');
        } elseif ($exposure['state'] === 'source') {
            $say('فحص الأمان: البيانات محميّة ✔ — لكن شيفرة المشروع مقروءة للزوار.', 'warn');
            $say('  ' . $exposure['hint'], 'warn');
        } else {
            $say('فحص الأمان: تعذّر الفحص الآلي — ' . $exposure['hint'], 'warn');
        }
        exit(0);
    }

    /* -------------------------- الصيانة -------------------------- */
    case 'migrate': {
        $ensureInstalled();
        require_once BASE_PATH . '/src/bootstrap.php';
        \App\Core\Migrations::migrate();
        $say('تم تحديث المخطط.', 'ok');
        exit(0);
    }

    case 'migrate:fresh': {
        $ensureInstalled();
        // حذف كل شيء لا يُعكس. نرفض التنفيذ بلا --force صراحةً،
        // ونأخذ نسخة احتياطية تلقائيًا قبل الحذف حتى لا تكون رجعة
        // ممكنة بلا سماء.
        if (!isset($options['force'])) {
            $say('هذا الأمر يحذف كل البيانات (كل الطلبات والمنتجات والإعدادات) نهائيًا.', 'warn');
            $say('للتأكيد أعِد الأمر مع --force:', 'warn');
            $say('    php bin/console migrate:fresh --force', 'warn');
            exit(1);
        }
        require_once BASE_PATH . '/src/bootstrap.php';
        $safety = \App\Services\BackupService::class;
        try {
            $backup = (new $safety())->create();
            $say('نسخة أمان: ' . basename($backup), 'ok');
        } catch (\Throwable $e) {
            $say('تعذّر إنشاء نسخة الأمان: ' . $e->getMessage() . ' — أُوقفت العملية.', 'err');
            exit(1);
        }
        \App\Core\Migrations::reset();
        $say('تمت إعادة إنشاء قاعدة البيانات (كل البيانات حُذفت).', 'warn');
        exit(0);
    }

    case 'admin:password': {
        $ensureInstalled();
        require_once BASE_PATH . '/src/bootstrap.php';
        $new = (string) ($options['pass'] ?? '');
        if ($new === '') {
            $new = bin2hex(random_bytes(4));
            $say('كلمة مرور جديدة (مولّدة): ' . $new, 'warn');
        }
        if (mb_strlen($new) < 8) {
            $say('كلمة المرور قصيرة جدًا.', 'err');
            exit(1);
        }
        $config = \App\Core\LocalConfig::read();
        $config['admin'] = is_array($config['admin'] ?? null) ? $config['admin'] : [];
        $config['admin']['password_hash'] = password_hash($new, PASSWORD_DEFAULT);
        $config['admin']['updated_at'] = date('c');

        try {
            $writeLocalConfig($config);
        } catch (\Throwable $e) {
            $say('تعذّر حفظ كلمة المرور: ' . $e->getMessage(), 'err');
            exit(1);
        }

        // تحقّق مستقل عن الكاتب: هل كلمة المرور الجديدة تُطابق الملف فعلًا؟
        $check = \App\Core\LocalConfig::read();
        if (!password_verify($new, (string) ($check['admin']['password_hash'] ?? ''))) {
            $say('كُتب الملف لكن كلمة المرور لم تُطبَّق — تحقّق من صلاحيات storage/config.', 'err');
            exit(1);
        }

        $say('تم تحديث كلمة مرور المدير.', 'ok');
        $say('اسم المستخدم : ' . (string) ($config['admin']['username'] ?? '—'));
        $say('كلمة المرور  : ' . $new, 'warn');
        $say('إن فشل الدخول، تأكّد أن الطرفية لم تُفسّر محارف خاصة ($ أو `) داخل كلمة المرور.', 'warn');
        exit(0);
    }

    /*
     * admin:reset — وصول طوارئ من الطرفية.
     *
     * يفرض بيانات الدخول الافتراضية المعروفة (admin / Test1234@) ويفكّ
     * قفل المحاولات، ثم يضمن وجود مفتاح الطوارئ ويطبع رابطه السرّي.
     * هذا هو المخرج الأخير حين تُفقد كلمة المرور أو يتعذّر الوصول للوحة.
     */
    case 'admin:reset': {
        $ensureInstalled();

        if (!isset($options['force'])) {
            $say('هذا الأمر يفرض بيانات دخول معروفة (الافتراضية) على حساب المدير:', 'warn');
            $say('  اسم المستخدم : ' . \App\Services\EmergencyService::DEFAULT_USERNAME);
            $say('  كلمة المرور  : ' . \App\Services\EmergencyService::DEFAULT_PASSWORD, 'warn');
            $say('استخدمه في الطوارئ فقط، وغيّر كلمة المرور فور استرجاع الوصول.', 'warn');
            $say('');
            $say('للتأكيد أعِد الأمر مع --force:', 'warn');
            $say('    php bin/console admin:reset --force', 'warn');
            exit(1);
        }

        require_once BASE_PATH . '/src/bootstrap.php';

        $user = trim((string) ($options['user'] ?? \App\Services\EmergencyService::DEFAULT_USERNAME));
        if ($user === '') {
            $user = \App\Services\EmergencyService::DEFAULT_USERNAME;
        }
        $pass = (string) ($options['pass'] ?? \App\Services\EmergencyService::DEFAULT_PASSWORD);
        if (mb_strlen($pass) < 8) {
            $say('كلمة المرور قصيرة جدًا (8 محارف على الأقل).', 'err');
            exit(1);
        }

        $config = \App\Core\LocalConfig::read();
        $config['admin'] = is_array($config['admin'] ?? null) ? $config['admin'] : [];
        $config['admin']['username']      = $user;
        $config['admin']['password_hash'] = password_hash($pass, PASSWORD_DEFAULT);
        $config['admin']['updated_at']    = date('c');

        try {
            $writeLocalConfig($config);
        } catch (\Throwable $e) {
            $say('تعذّر حفظ البيانات: ' . $e->getMessage(), 'err');
            exit(1);
        }

        // تحقّق مستقل: هل كلمة المرور المفروضة تُطابق الملف فعلًا؟
        $check = \App\Core\LocalConfig::read();
        if (!password_verify($pass, (string) ($check['admin']['password_hash'] ?? ''))) {
            $say('كُتب الملف لكن كلمة المرور لم تُطبَّق — تحقّق من صلاحيات storage/config.', 'err');
            exit(1);
        }

        // فكّ قفل محاولات الدخول الفاشلة حتى يعمل الدخول فورًا.
        try {
            \App\Core\Database::delete('login_attempts', '1 = 1');
        } catch (\Throwable) {
            // قاعدة غير مهيأة أو تعذّر الوصول: لا يمنع ذلك فرض البيانات.
        }

        $emergency = new \App\Services\EmergencyService();
        $key       = $emergency->ensureKey();
        $url       = $emergency->url();
        $fallback  = rtrim((string) app_config('app.base_url', ''), '/');

        \App\Core\Logger::warning('Admin credentials forced via admin:reset', [
            'username' => $user,
            'ip'       => 'cli',
        ]);

        $say('تم فرض بيانات الدخول.', 'ok');
        $say('اسم المستخدم : ' . $user);
        $say('كلمة المرور  : ' . $pass, 'warn');
        $say('');
        $say('رابط التدمير الطارئ (سرّي — احفظه في مكان آمن):', 'head');
        $say('  ' . ($url !== '' ? $url : ($fallback !== '' ? $fallback : '<نطاقك>') . '/emergency.php?key=' . $key), 'ok');
        $say('');
        $say('لتغيير كلمة المرور الآن: php bin/console admin:password --pass="…"', 'warn');
        exit(0);
    }

    case 'backup': {
        $ensureInstalled();
        require_once BASE_PATH . '/src/bootstrap.php';
        $service = new \App\Services\BackupService();
        $path = $service->create();
        $say('تم إنشاء نسخة احتياطية: ' . basename($path), 'ok');
        exit(0);
    }

    /* -------------------------- الأيقونات -------------------------- */
    case 'icons': {
        require_once BASE_PATH . '/src/Tools/IconGenerator.php';
        $result = \App\Tools\IconGenerator::generateAll();
        foreach ($result as $file) {
            $say('تم إنشاء: ' . $file, 'ok');
        }
        exit(0);
    }

    /* -------------------------- رمز QR -------------------------- */
    case 'qr': {
        require_once BASE_PATH . '/src/Core/Autoloader.php';
        $text = (string) ($options['text'] ?? '');
        if ($text === '' && isset($args[1]) && !str_starts_with($args[1], '--')) {
            $text = $args[1];
        }
        if ($text === '') {
            $say('الاستخدام: php bin/console qr "النص" --out=file.svg', 'warn');
            exit(1);
        }
        $qr  = new \App\Core\Qr\QrCode((string) ($options['ecc'] ?? 'M'));
        $svg = $qr->svg($text, (int) ($options['size'] ?? 8));
        $out = (string) ($options['out'] ?? '');
        if ($out === '') {
            echo $svg;
        } else {
            file_put_contents($out, $svg);
            $say('تم حفظ الرمز في ' . $out, 'ok');
        }
        exit(0);
    }

    /* -------------------------- الحالة -------------------------- */
    case 'status': {
        $ensureInstalled();
        require_once BASE_PATH . '/src/bootstrap.php';
        $db = \App\Core\Database::pdo();
        $say('PHP: ' . PHP_VERSION);
        $say('إصدار القالب: ' . \App\Config\ProjectConfig::VERSION);
        $say('النمط: ' . \App\Config\ProjectConfig::presetLabel()
            . ' (' . \App\Config\ProjectConfig::presetId() . ')');
        $say('القدرات: ' . \App\Config\TemplatePatterns::describe(\App\Config\ProjectConfig::pattern()));
        $say('الوضع: ' . (\App\Config\ProjectConfig::hasOrdering()
            ? 'مع نظام الطلبات' : 'عرض فقط — بلا طلبات'));
        $say('تسميات المنتجات: ' . \App\Config\ProjectConfig::productSingular()
            . ' / ' . \App\Config\ProjectConfig::productPlural());
        $companyFile = \App\Core\CompanyProfile::path();
        $say('ملف الشركة: ' . (is_file($companyFile) ? 'موجود (' .
            \App\Core\CompanyProfile::sectionCount() . ' قسم، ' .
            (\App\Core\CompanyProfile::hasContactWays() ? 'فيه تواصل' : 'بلا تواصل') . ')'
            : 'غير موجود — يعمل بإعدادات افتراضية'),
            is_file($companyFile) ? 'ok' : 'warn');
        $say('قاعدة البيانات: ' . app_config('db.path', '?'));
        foreach (['products', 'categories', 'locations', 'orders'] as $table) {
            $count = (int) \App\Core\Database::value("SELECT COUNT(*) FROM $table");
            $say(str_pad($table, 12) . ': ' . $count);
        }
        $version = \App\Core\Database::value('SELECT value FROM app_meta WHERE key = :k', ['k' => 'schema_version']);
        $say('مخطط قاعدة البيانات: ' . ($version ?: '؟'));
        $say('الإعدادات: ' . (is_writable(BASE_PATH . '/storage') ? 'قابلة للكتابة' : 'غير قابلة للكتابة'), is_writable(BASE_PATH . '/storage') ? 'ok' : 'err');

        // حالة باب الطوارئ: مفعّل بمفتاح، أم مغلق بحذف الملف.
        $emergencyInfo = new \App\Services\EmergencyService();
        if ($emergencyInfo->isArmed()) {
            $emergencyUrl = $emergencyInfo->url();
            $say('رابط الطوارئ: ' . ($emergencyUrl !== '' ? $emergencyUrl : '(مفتاح موجود — النطاق غير معروف)'), 'warn');
        } else {
            $say('رابط الطوارئ: معطّل (لا مفتاح) — فعّله: php bin/console admin:reset --force', 'warn');
        }

        // تنبيه أمني سريع: هل ما زالت حماية المسارات الحسّاسة فعّالة؟
        $baseUrl = rtrim((string) app_config('app.base_url', ''), '/');
        if ($baseUrl !== '') {
            $exposure = \App\Core\Security\ExposureCheck::run($baseUrl, 4);
            $labels = [
                'secure'   => 'البيانات محميّة ✔',
                'source'   => 'البيانات محميّة ✔ (الشيفرة مقروءة)',
                'critical' => 'بيانات مكشوفة ✘',
                'unknown'  => 'تعذّر الفحص',
            ];
            $label = $labels[$exposure['state']] ?? '؟';
            $tone = $exposure['state'] === 'secure' ? 'ok' : ($exposure['state'] === 'critical' ? 'err' : 'warn');
            $say('حماية البيانات: ' . $label, $tone);
            if ($exposure['state'] === 'critical' || $exposure['state'] === 'source') {
                $say('  شغّل: php bin/console security:check للتفاصيل', $tone);
            }
        }
        exit(0);
    }

/* --------------------- تغيير نوع النشاط والوضع --------------------- */
    case 'preset': {
        $ensureInstalled();
        require_once BASE_PATH . '/src/bootstrap.php';
        \App\Config\ProjectConfig::applyStoredPreset();

        $action = $argv[2] ?? 'show';

        if ($action === 'list') {
            $say('أنماط القدرات المتاحة:');
            $current = \App\Config\ProjectConfig::presetId();
            foreach (\App\Config\TemplatePatterns::all() as $key => $pattern) {
                $blueprint = (array) ($pattern['blueprint'] ?? []);
                $mark = $key === $current ? '  <- الحالي' : '';
                $mode = ($blueprint['ordering'] ?? '') === \App\Config\TemplatePatterns::ORDER_NONE
                    ? 'عرض فقط  ' : 'مع الطلبات';
                $say('  ' . str_pad($key, 18) . $mode . '  ' . ($pattern['label'] ?? $key) . $mark);
            }
            $say('');
            $say('تُقبل أيضًا المعرّفات القديمة (restaurant / store / clinic…) للتوافق.');
            $say('التطبيق: php bin/console preset apply <المعرّف>');
            exit(0);
        }

        if ($action === 'show') {
            $say('النمط الحالي: ' . \App\Config\ProjectConfig::presetLabel()
                . ' (' . \App\Config\ProjectConfig::presetId() . ')');
            $say('الوضع: ' . (\App\Config\ProjectConfig::hasOrdering()
                ? 'مع نظام الطلبات' : 'عرض فقط — بلا سلة ولا طلبات'));
            $say('القدرات: ' . \App\Config\TemplatePatterns::describe(\App\Config\ProjectConfig::pattern()));
            $say('تسميات المنتجات: ' . \App\Config\ProjectConfig::productSingular()
                . ' / ' . \App\Config\ProjectConfig::productPlural());
            $say('');
            $say('للعرض: php bin/console preset list');
            exit(0);
        }

        if ($action === 'apply') {
            $id = $argv[3] ?? '';
            if (!\App\Config\TemplatePatterns::exists($id)
                && !\App\Config\BusinessPresets::exists($id)) {
                $say('معرّف غير معروف: ' . $id, 'err');
                $say('استخدم: php bin/console preset list لعرض المتاح', 'err');
                exit(1);
            }

            $overrides = \App\Config\TemplatePatterns::toOverrides($id);
            \App\Core\RuntimeSettings::setMany([
                'business_preset'    => $id,
                'template_blueprint' => json_encode(
                    (array) ($overrides['template_blueprint'] ?? []),
                    JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES
                ) ?: '',
            ]);
            \App\Core\RuntimeSettings::flush();

            $say('تم حفظ النمط: ' . ($overrides['preset_label'] ?? $id));
            $say('الوضع الجديد: ' . (($overrides['mode'] ?? '') === \App\Config\TemplatePatterns::MODE_ORDERS
                ? 'مع نظام الطلبات' : 'عرض فقط — بلا سلة ولا طلبات'));
            $say('القدرات: ' . \App\Config\TemplatePatterns::describe(
                (array) ($overrides['template_blueprint'] ?? [])
            ));
            $say('تسميات المنتجات: ' . ($overrides['product_singular'] ?? '')
                . ' / ' . ($overrides['product_plural'] ?? ''));
            $say('');
            $say('تنبيه: تغيّرت حقول المنتجات وأنواع الطلبات. المنتجات المحفوظة تحتفظ');
            $say('ببياناتها القديمة داخل extra_json، فراجع نموذج المنتج بعد التبديل.');
            exit(0);
        }

        $say('استخدام: php bin/console preset [list|show|apply <المعرّف>]', 'err');
        exit(1);
    }

    /* -------------------------- بيانات تجريبية -------------------------- */

    /* -------------------------- بيانات تجريبية -------------------------- */
    case 'seed:demo': {
        $ensureInstalled();
        require_once BASE_PATH . '/src/bootstrap.php';
        require BASE_PATH . '/src/Tools/DemoSeeder.php';
        $count = \App\Tools\DemoSeeder::run();
        $say('تمت إضافة بيانات تجريبية (' . $count . ' منتج). احذفها قبل الإطلاق الحقيقي.', 'warn');
        exit(0);
    }

    case 'security:check': {
        $ensureInstalled();
        require_once BASE_PATH . '/src/bootstrap.php';

        $baseUrl = rtrim((string) app_config('app.base_url', ''), '/');

        // تجاوز الرابط مفيد داخل الحاويات (حيث لا يعمل رابط الاستضافة من الداخل)
        if (isset($options['url']) && is_string($options['url']) && $options['url'] !== '') {
            $baseUrl = rtrim($options['url'], '/');
        }

        if ($baseUrl === '') {
            $say('لا يوجد رابط محفوظ للنسخة. مرّر الرابط: --url=https://...', 'err');
            exit(1);
        }

        $say('فحص تسريب المسارات الحسّاسة على: ' . $baseUrl, 'head');
        $result = \App\Core\Security\ExposureCheck::run($baseUrl);

        if ($result['state'] === 'secure') {
            $say('النتيجة: البيانات محميّة ✔  (' . $result['checked'] . ' مسارًا تم فحصها)', 'ok');
            exit(0);
        }

        if ($result['state'] === 'unknown') {
            $say('النتيجة: تعذّر الفحص', 'warn');
            $say($result['hint']);
            exit(2);
        }

        // source = شيفرة المالك مكشوفة | critical = بيانات الزبائن مكشوفة
        if ($result['state'] === 'source') {
            $say('النتيجة: البيانات محميّة ✔ — لكن شيفرة المشروع مقروءة للزوار', 'warn');
        } else {
            $say('النتيجة: بيانات حسّاسة مكشوفة ✘', 'err');
        }

        $say('');
        foreach ($result['exposed'] as $item) {
            $mark = $item['severity'] === 'critical' ? 'خطر' : 'ملاحظة';
            $tone  = $item['severity'] === 'critical' ? 'err' : 'warn';
            $say('  - ' . $item['path'] . '  (' . $item['label'] . ')  HTTP ' . $item['status'] . '  [' . $mark . ']', $tone);
        }
        $say('');
        $say($result['hint'], 'warn');
        exit($result['state'] === 'critical' ? 1 : 0);
    }

    /* ------------------ دورة حياة النسخة: تدمير وبناء جديد ------------------ */
    case 'instance': {
        $action = $argv[2] ?? 'state';
        $service = new \App\Services\InstanceService();

        if ($action === 'state') {
            $state = $service->state();
            $say('حالة النسخة: ' . ($state['installed'] ? 'مهيأة' : 'غير مهيأة (قبل أول بناء)'), $state['installed'] ? 'ok' : 'warn');
            $say('إصدار القالب: ' . $state['template_version']);
            if ($state['installed']) {
                /*
                 * bootstrap يقرأ النمط المحفوظ ويطبّقه. بدونه يُرجع
                 * ProjectConfig الثابت الافتراضي بدل النمط الحقيقي
                 * للنسخة — فيُظهر التقرير نمطًا لم تختره.
                 */
                require_once BASE_PATH . '/src/bootstrap.php';
                $state = $service->state();
                $say('النمط        : ' . ($state['preset'] ?? '؟')
                    . ' (' . \App\Config\ProjectConfig::presetId() . ')');
                $say('الوضع        : ' . (\App\Config\ProjectConfig::hasOrdering()
                    ? 'مع نظام الطلبات' : 'عرض فقط — بلا سلة ولا طلبات'));
                $say('رابط الموقع : ' . ($state['base_url'] ?? '؟'));
                foreach ($state['counts'] as $table => $n) {
                    $say('  ' . str_pad($table, 12) . ': ' . $n);
                }
                $say('أحجام: قاعدة ' . $state['sizes']['database']
                    . ' · صور ' . $state['sizes']['uploads']
                    . ' · نسخ ' . $state['sizes']['backups']);
            }
            $say('ملف الإعدادات: ' . $state['paths']['config']);
            $say('صفحة التهيئة : ' . ($state['setup_available'] ? 'موجودة' : 'محذوفة — أعد رفع مجلد setup/ للبناء من جديد'));

            if ($key = $service->rebuildKey()) {
                $say('');
                $say('إعادة البناء مقفلة بمفتاح. الرابط الكامل:', 'head');
                $base = rtrim((string) app_config('app.base_url', ''), '/');
                $say('  ' . ($base !== '' ? $base : '<نطاقك>') . '/setup/index.php?key=' . $key, 'ok');
            } elseif ($service->rebuildPending()) {
                $say('');
                $say('النسخة مدمَّرة وصفحة التهيئة مقفلة (لا مفتاح محفوظ).', 'warn');
                $say('لتنفيذ مفتاح جديد: php bin/console instance destroy --force', 'warn');
            }
            if ($state['archives'] !== []) {
                $say('');
                $say('نسخ الأمان السابقة:', 'head');
                foreach ($state['archives'] as $archive) {
                    $say('  ' . $archive['date'] . '  ' . \App\Services\InstanceService::ARCHIVE_DIR
                        . '/' . $archive['name']);
                }
            }
            exit(0);
        }

        if ($action === 'destroy') {
            if (!isset($options['force'])) {
                $say('هذا الأمر يمحو النسخة بالكامل بلا رجعة: البيانات والإعدادات والصور', 'warn');
                $say('والنسخ الاحتياطية. تُؤخذ نسخة أمان أولًا في ' . \App\Services\InstanceService::ARCHIVE_DIR . '/.', 'warn');
                $say('');
                $say('للتأكيد أعِد الأمر مع --force:', 'warn');
                $say('    php bin/console instance destroy --force', 'warn');
                exit(1);
            }
            /*
             * الشرط ليس «مهيأة» فحسب: نسخة مدمّرة بلا مفتاح (دمّرها
             * إصدار سابق للميزة) هي أيضًا حالة موجودة، وتدميرها هو
             * المخرج الوحيد لتدوير مفتاح ضائع. فنسأل عن وجود أي أثر
             * للنسخة، لا عن اكتمال تهيئتها.
             */
            if (!$service->isInstalled() && !$service->rebuildPending()) {
                $say('لا توجد نسخة لتدميرها — يبدو أن هذه نسخة جديدة لم تُبنَ بعد.', 'warn');
                $say('للبناء الأول: php bin/console install --url=... --user=... --pass="…"', 'warn');
                exit(1);
            }

            require_once BASE_PATH . '/src/bootstrap.php';

            try {
                $report = $service->destroy('', [
                    'confirm'      => \App\Services\InstanceService::CONFIRM_WORD,
                    'archive'      => !isset($options['no-archive']),
                    'keep_backups' => isset($options['keep-backups']),
                ]);
            } catch (\Throwable $e) {
                $say($e->getMessage(), 'err');
                exit(1);
            }

            $say('تم تدمير النسخة.', 'warn');
            $say('حُذف ' . count($report['removed']) . ' عنصرًا. محتواها:');
            foreach (array_slice($report['removed'], 0, 20) as $item) {
                $say('  - ' . $item);
            }
            if (count($report['removed']) > 20) {
                $say('  … و ' . (count($report['removed']) - 20) . ' عنصرًا آخر');
            }
            if ($report['archive'] !== '') {
                $say('');
                $say('نسخة الأمان: ' . $report['archive'], 'ok');
            }
            $say('');
            $say('مفتاح إعادة البناء: ' . $report['rebuildKey'], 'ok');
            if (!empty($report['rebuildUrl'])) {
                $say('رابط البناء الجديد:');
                $say('  ' . $report['rebuildUrl'], 'ok');
            } else {
                $say('لا رابط محفوظ للنسخة، فافتح على نطاقك:', 'warn');
                $say('  setup/index.php?key=' . $report['rebuildKey']);
            }
            $say('');
            $say('الخطوة التالية — البناء من جديد:', 'head');
            $say('  ١) افتح الرابط أعلاه — مفتاحه إلزامي، وبدونه الصفحة مقفلة.');
            $say('  ٢) أو من الطرفية مباشرة (لا تحتاج مفتاحًا):');
            $say('     php bin/console install --url=... --user=... --pass="…" --preset=<النوع>');
            exit(0);
        }

        $say('استخدام: php bin/console instance [state|destroy --force]', 'err');
        exit(1);
    }

    default:
        echo <<<TXT
        أداة القالب التجاري الخفيف

        الأوامر المتاحة:
          install --url=... --user=... --pass=...   تهيئة النسخة لأول مرة
                  [--preset=<نمط>] [--name=...] [--tagline=...]
          migrate                                   تحديث مخطط قاعدة البيانات
          migrate:fresh                             حذف كل البيانات وإعادة الإنشاء
          instance state                            حالة النسخة وما سيُحذف
          instance destroy --force                  تدمير النسخة والعودة للبداية
                  [--no-archive] [--keep-backups]
          admin:password --pass=...                 تعيين كلمة مرور المدير
          admin:reset --force                       فرض بيانات الدخول الافتراضية (طوارئ)
                  [--user=...] [--pass=...]         وطبع رابط التدمير السرّي
          preset list|show|apply <المعرّف>         عرض أو تغيير نمط القدرات والوضع
          backup                                    إنشاء نسخة احتياطية
          icons                                     توليد أيقونات PWA
          qr "نص" --out=file.svg                    توليد رمز QR كـ SVG
          seed:demo                                 إضافة بيانات تجريبية
          security:check                           فحص حماية المسارات الحسّاسة
          status                                    عرض حالة النسخة

        أنماط القدرات: orders_tables | orders | reservations | showcase
          showcase_details | showcase_order | custom
          الأنماط التي فيها طلبات: orders_tables | orders | showcase_order | reservations
          المعرّفات القديمة (restaurant/store/showroom/clinic/studio/general) ما زالت مقبولة.

        TXT;
        exit($command === 'help' ? 0 : 1);
}