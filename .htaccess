# =============================================================================
# إعدادات Apache على مستوى جذر المشروع
# الهدف: منع الوصول إلى src/ و storage/ و bin/ و tests/ مع إبقاء app و admin و api.
# يعمل على استضافات PHP العادية التي تستخدم Apache مع .htaccess.
# =============================================================================

# لا تُعرض محتويات المجلدات
Options -Indexes -MultiViews

DirectoryIndex app/index.html
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # منع الوصول إلى المسارات الحساسة entirely
    RewriteRule ^(src|storage|bin|tests|docker)/? - [R=404,L]
    RewriteRule ^(composer\.(json|lock)|\.env|\.git) - [R=404,L]
    RewriteRule ^\. - [R=404,L]

    # تحويل الجذر إلى واجهة الزبون
    RewriteRule ^$ app/index.html [L]
</IfModule>

# ترويسات أمان أساسية
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
</IfModule>

# لا تُخزّن استجابات الـ API الحساسة في أي ذاكرة وسيطة
<FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm|log|md)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-store"
    </IfModule>
</FilesMatch>

# أنواع MIME صحيحة
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType image/svg+xml .svg
</IfModule>

# حماية إضافية إن كان mod_php يعمل
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>