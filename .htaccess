# =============================================================================
# إعدادات Apache على مستوى جذر المشروع
# الهدف: منع الوصول إلى src/ و storage/ و bin/ و tests/ مع إبقاء app و admin و api.
# يعمل على استضافات PHP العادية التي تستخدم Apache مع .htaccess.
#
# ملاحظة مهمة حول الروابط: واجهة الزبون تُقدَّم من الجذر "/" عبر index.php،
# فالمسارات عامة ونظيفة: /cart و /checkout و /order/{رمز}.
#Legacy /app/index.html يبقى يعمل، لكنه يوجّه فورًا إلى الجذر (301).
# =============================================================================

# لا تُعرض محتويات المجلدات
Options -Indexes -MultiViews

# الجذر = واجهة الزبون (index.php) — لا app/index.html بعد الآن
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ---------------------------------------------------------------- منع الوصول
    RewriteRule ^(src|storage|bin|tests|tools|docs|docker)(/|$) - [R=404,L]
    RewriteRule ^(composer\.(json|lock)|\.env|\.git) - [R=404,L]
    RewriteRule ^\. - [R=404,L]
    RewriteRule ^(README|CHANGELOG|AUDIT_REPORT)\.md$ - [R=404,L]

    # ------------------------------------------------------- روابط موحّدة (301)
    # الرابط القديم أو المكرر يوجّه إلى الجذر، مع الحفاظ على معاملات الرابط
    # (مثل ?loc=CODE في رموز QR المطبوعة سابقًا).
    RewriteRule ^app/index\.html$ / [R=301,L]
    RewriteRule ^app/$ / [R=301,L]
    RewriteRule ^index\.php$ / [R=301,L]

    # المجلدات الفرعية بلا شرطة مائلة: /admin → /admin/
    # (وإلا حُلّت مسارات الملفات النسبية من الجذر فاختفت الأنماط والسكربتات)
    RewriteRule ^admin$ admin/ [R=301,L]
    RewriteRule ^setup$ setup/ [R=301,L]

    # ------------------------------------------------ تطبيق صفحة واحدة (SPA)
    # كل مسار غير موجود يُقدَّم عبر index.php، وهو من يتعرف على
    # /cart و /checkout و /order/... — أما الملفات الموجودة فتُقدَّم كما هي.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

# ترويسات أمان أساسية
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
</IfModule>

# لا تُخزّن استجابات الـ API الحساسة في أي ذاكرة وسيطة
<FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm|log)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-store"
    </IfModule>
</FilesMatch>

# أنواع MIME صحيحة
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType image/svg+xml .svg
</IfModule>

# حماية إضافية إن كان mod_php يعمل
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>