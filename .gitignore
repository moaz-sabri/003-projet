# ---------------------------------------------------------------------------
# ملفات التشغيل والملفات الحساسة — لا تُرفع أبدًا إلى المستودع
# ---------------------------------------------------------------------------

# الأسرار وبيانات الدخول
/storage/config/local.php
.env

# قاعدة البيانات
# ملاحظة: لا ملفات .gitkeep هنا عمدًا — كل مجلد من هذه المجلدات ينشئ نفسه
# عند الحاجة (Database/Logger/RateLimiter/BackupService/ImageUploader)،
# فسطران ينفيان ملفات غير موجودة كانا قاعدة تُступك بلا فائدة.
/storage/database/*.sqlite
/storage/database/*.sqlite-*
/storage/backups/*
/storage/destroyed/*
/storage/logs/*
/storage/tmp/*

# الصور المرفوعة من لوحة الإدارة (تُنشأ على الخادم)
/app/uploads/*
!/app/uploads/.htaccess

# ---------------------------------------------------------------------------
# أرشيفات وملفات نسخ — أخطر تسرب ممكن داخل جذر الموقع.
# أرشيف واحد (.zip) في public_html يعني تحميل storage/config/local.php
# (تجزئة كلمة مرور المدير + مفتاح التطبيق) وstorage/database/app.sqlite
# (كل الطلبات وأسماء الزبائن) بترويسة واحدة. لا تُنشئ أرشيفًا هنا أبدًا،
# واحذف أي أرشيف موجود قبل الرفع.
# ---------------------------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.7z
*.rar
*.iso
*.sql
*.dump

# ---------------------------------------------------------------------------
# ملفات البناء المؤقتة
# ---------------------------------------------------------------------------
test.md

# نظام التشغيل والمحررات
.DS_Store
Thumbs.db
/.idea
/.vscode
*.swp

# ---------------------------------------------------------------------------
# ملفات مولّدة محليًا لكنها ضرورية للقالب — تُرفع عمدًا:
#   app/manifest.webmanifest  (بيان التطبيق)
#   app/assets/icons/*.png    (أيقونات PWA — تُعاد توليدها بـ: php bin/console icons)
# ---------------------------------------------------------------------------